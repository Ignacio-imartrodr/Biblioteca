<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Unidad de persistencia usada por Main: Persistence.createEntityManagerFactory("bibliotecaPU") -->
    <persistence-unit name="bibliotecaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades gestionadas -->
        <class>com.example.biblioteca.model.Usuario</class>
        <class>com.example.biblioteca.model.Genero</class>
        <class>com.example.biblioteca.model.Libro</class>
        <class>com.example.biblioteca.model.Prestamo</class>

        <properties>
            <!-- Conexión (propiedades estándar JPA) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:BD/biblioteca.db"/>

            <!-- Generación del esquema (estándar JPA): create, drop-and-create, update... -->
            <!-- Equivalente estándar a hibernate.hbm2ddl.auto=update -->
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>

            <!-- Única propiedad propia de Hibernate: mostrar el SQL que se ejecuta -->
            <property name="hibernate.show_sql" value="true"/>

            <!-- Dialecto: inevitablemente específico del proveedor, pero es el único -->
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
        </properties>
    </persistence-unit>
</persistence>
